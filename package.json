{
  "name": "gitverse-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server covering the full GitVerse public REST API — all endpoints generated from the official OpenAPI specification",
  "type": "module",
  "license": "MIT",
  "author": "grisha123",
  "bin": {
    "gitverse-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch-spec": "tsx scripts/fetch-spec.ts",
    "generate": "tsx scripts/generate.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gitverse",
    "gitverse-api",
    "mcp-server",
    "rest-api",
    "openapi",
    "llm",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitverse.ru/grisha123/gitverse-mcp-server.git"
  },
  "bugs": {
    "url": "https://gitverse.ru/grisha123/gitverse-mcp-server/issues"
  },
  "homepage": "https://gitverse.ru/grisha123/gitverse-mcp-server#readme"
}
