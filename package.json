{
  "name": "@grigoriy-grisha/gitverse-mcp",
  "version": "1.0.0",
  "description": "MCP server for GitVerse: repositories, pull requests, reviews, comments and CI",
  "type": "module",
  "license": "MIT",
  "author": "grigoriy-grisha",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "gitverse-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gitverse",
    "gitverse-api",
    "mcp-server",
    "bitbucket",
    "pull-requests",
    "code-review",
    "llm",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grigoriy-grisha/gitverse-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/grigoriy-grisha/gitverse-mcp/issues"
  },
  "homepage": "https://github.com/grigoriy-grisha/gitverse-mcp#readme"
}
